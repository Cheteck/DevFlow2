{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@mosaix/otp": ["./packages/otp/src/index.ts"],
      "@mosaix/otp/*": ["./packages/otp/src/*"],
      "@mosaix/ports-crypto": ["./packages/ports/crypto/src/index.ts"],
      "@mosaix/ports-clock": ["./packages/ports/clock/src/index.ts"],
      "@mosaix/ports-logging": ["./packages/ports/logging/src/index.ts"],
      "@mosaix/ports-secrets": ["./packages/ports/secrets/src/index.ts"],
      "@mosaix/ports-id": ["./packages/ports/id/src/index.ts"],
      "@mosaix/ports-config": ["./packages/ports/config/src/index.ts"],
      "@mosaix/ports-cache": ["./packages/ports/cache/src/index.ts"],
      "@mosaix/ports-email": ["./packages/ports/email/src/index.ts"],
      "@mosaix/ports-sms": ["./packages/ports/sms/src/index.ts"],
      "@mosaix/ports-whatsapp": ["./packages/ports/whatsapp/src/index.ts"],
      "@mosaix/adapter-crypto-node": ["./packages/adapters/crypto-node/src/index.ts"],
      "@mosaix/adapter-clock-system": ["./packages/adapters/clock-system/src/index.ts"],
      "@mosaix/adapter-id-uuid": ["./packages/adapters/id-uuid/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "bootstrap/**/*.ts",
    "packages/*/src/**/*.ts",
    "packages/adapters/*/src/**/*.ts",
    "packages/ports/*/src/**/*.ts",
    "apps/*/src/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".mosaix",
    "apps/_template",
    "remotion",
    "**/*.test.ts"
  ]
}
