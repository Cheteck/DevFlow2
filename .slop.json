{
  "version": 1,
  "scopes": ["code"],
  "strict": false,
  "base": "origin/main",
  "rules": {
    "SLOP-P0-01": "error",
    "SLOP-P0-02": "error",
    "SLOP-P0-03": "error",
    "SLOP-P0-04": "error",
    "SLOP-P0-05": "error",
    "SLOP-P0-06": "error",
    "SLOP-P0-07": "error",
    "SLOP-P1-01": "warn",
    "SLOP-P1-02": "warn",
