{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "../../.mosaix/build/packages/auth",
    "rootDir": "../..",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "tsBuildInfoFile": "../../.mosaix/build/packages/auth/.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.test.ts"
  ],
  "references": [
    {
      "path": "../types"
    },
    {
      "path": "../contracts"
    },
    {
      "path": "../ports/identity-store"
    },
    {
      "path": "../ports/session-store"
    },
    {
      "path": "../ports/credential-store"
    },
    {
      "path": "../ports/token-store"
    }
  ]
}
