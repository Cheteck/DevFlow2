{
  "name": "@mosaix/plugin-engine",
  "version": "0.1.0",
  "description": "MosaiX Plugin Engine — composable, secure, and observable plugin runtime and management system",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./management": {
      "types": "./dist/management/index.d.ts",
      "default": "./dist/management/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    }
  },
  "scripts": {
    "dev": "tsc --build --watch",
    "build": "tsc --build",
    "clean": "rimraf dist",
    "test": "vitest run"
  },
  "files": [
    "dist"
  ],
  "eslintBoundaries": {
    "type": "framework-primitive"
  },
  "dependencies": {
    "@mosaix/contracts": "workspace:*",
    "@mosaix/types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
