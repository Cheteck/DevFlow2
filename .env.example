# MosaiX — documented environment template.
# Copy to `.env` for local dev: `cp .env.example .env`
# Canonical keys use the `MOSAIX_*` prefix. Legacy aliases (PORT, APP_PORT,
# DATABASE_URL, REDIS_URL, JWT_SECRET) still work with a dev warning but are
# deprecated — prefer the canonical keys below.
# Generate secrets with: pnpm key:generate (Laravel-style, see README)
# Source of truth for validation: packages/core/src/env/env.schema.ts

# ── Runtime ──────────────────────────────────────────────
# development | staging | production
MOSAIX_ENV=development
NODE_ENV=development
# Canonical port (aliases APP_PORT / PORT accepted, MOSAIX_PORT wins)
MOSAIX_PORT=3000
# Legacy aliases (deprecated, kept for compat — prefer MOSAIX_PORT):
#APP_PORT=
#PORT=
MOSAIX_COMPOSITION=community-platform
MOSAIX_DEFAULT_BAC=solara
MOSAIX_MAINTENANCE_MODE=false
# Demo session switcher (usermenu "Aperçu Démo", ?role=, /api/user/switch).
# true/false to force, empty = auto (enabled everywhere except production).
#MOSAIX_DEMO_USERS=

# ── Auth / secrets (prod: JWT >= 32 chars, no dev fallbacks) ──
# Master encryption key (Laravel-style `base64:`). Generate: pnpm key:generate
#MOSAIX_APP_KEY=
#MOSAIX_APP_CIPHER=AES-256-CBC
# Previous keys accepted during rotation (comma-separated, Laravel APP_PREVIOUS_KEYS):
#MOSAIX_APP_PREVIOUS_KEYS=
MOSAIX_AUTH_JWT_SECRET=change-me-32-chars-minimum-xxxxxxxxxxxx
# Previous JWT secrets accepted at verification during rotation:
#MOSAIX_AUTH_PREVIOUS_SECRETS=
# Legacy alias (deprecated — prefer MOSAIX_AUTH_JWT_SECRET):
#JWT_SECRET=
MOSAIX_SESSION_SECRET=change-me-32-chars-minimum-xxxxxxxxxxxx
MOSAIX_AUTH_TOKEN_TTL=3600
MOSAIX_ADMIN_API_KEY=
ADMIN_EMAIL=admin@mosaix.local
# ADMIN_PASSWORD is generated at first boot if empty (scripts/init-dev-admin.ts)
#ADMIN_PASSWORD=

# ── Data (canonical; DATABASE_URL / REDIS_URL accepted as aliases) ──
MOSAIX_DATABASE_URL=postgresql://mosaix:mosaix@localhost:5432/mosaix
MOSAIX_REDIS_URL=redis://localhost:6379
# Legacy aliases (deprecated):
#DATABASE_URL=
#REDIS_URL=

# ── HTTP ──
CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUST_PROXY=false
# Set true only to allow in-memory adapters in production (default false)
#ALLOW_IN_MEMORY_IN_PRODUCTION=false

# ── Media / CDN ──
MOSAIX_CDN_BASE_URL=https://cdn.mosaix.local
#MOSAIX_CDN_SECRET=
PSP_WEBHOOK_SECRET=

# ── OAuth (optional — empty = provider disabled) ──
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#GITHUB_CLIENT_ID=
#GITHUB_CLIENT_SECRET=
#MICROSOFT_CLIENT_ID=
#MICROSOFT_CLIENT_SECRET=
#MICROSOFT_TENANT=common
#APPLE_CLIENT_ID=
#APPLE_CLIENT_SECRET=
#APPLE_TEAM_ID=
#APPLE_KEY_ID=
#APPLE_PRIVATE_KEY=

# ── Telemetry (optional) ──
#MOSAIX_TELEMETRY_OTLP_ENDPOINT=http://localhost:4318/v1/traces
