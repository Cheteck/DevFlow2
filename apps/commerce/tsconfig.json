{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "../../.mosaix/build/apps/commerce",
    "rootDir": ".",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "tsBuildInfoFile": "../../.mosaix/build/apps/commerce/.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts",
    "frontend/src/**/*.ts"
