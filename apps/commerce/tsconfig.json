    {
      "path": "../../plugins/commerce-recently-viewed-plugin"
    },
    {
      "path": "../../plugins/commerce-reviews-plugin"
    },
    {
      "path": "../../plugins/commerce-wishlist-plugin"
    },
    {
      "path": "../../packages/sdk"
    },
    {
      "path": "../../packages/types"
    },
    {
      "path": "../../packages/conformance"
    }
  ]
