{
  "name": "mosaix",
  "version": "0.1.0",
  "description": "Modular Orchestration for Smart Application Integration and eXperiences",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "workspaces": [
    "packages/*",
    "packages/adapters/*",
    "packages/ports/*",
    "apps/*",
    "!apps/_template",
    "plugins/*"
  ],
  "scripts": {
    "mosaix": "tsx packages/cli/src/index.ts",
    "key:generate": "tsx scripts/key-generate.ts",
    "key:check": "tsx scripts/key-check.ts",
    "setup": "tsx scripts/install.ts",
    "dev": "tsx scripts/dev.ts",
    "db:setup": "tsx scripts/setup-sqlite.ts",
    "build": "tsx scripts/build.ts",
    "build:watch": "tsx scripts/build.ts --watch",
    "build:force": "tsx scripts/build.ts --force",
    "build:clean": "tsx scripts/build.ts --clean",
    "build:verbose": "tsx scripts/build.ts --verbose",
    "build:report": "tsx scripts/build.ts --report",
    "build:ci": "tsx scripts/build.ts --ci --report",
    "build:raw": "tsc --build tsconfig.build.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:typecheck": "tsc --noEmit -p packages/contracts/tsconfig.test.json && tsc --noEmit -p packages/schemas/tsconfig.test.json",
    "check": "pnpm check:conformance && pnpm check:manifests && pnpm check:contracts && pnpm check:themes && pnpm build && pnpm lint && pnpm test:typecheck && pnpm test && pnpm exec prettier --check . && pnpm check:ui-contracts",
    "check:conformance": "tsx scripts/validate-conformance.ts",
    "check:env": "tsx scripts/check-env.ts",
    "check:manifests": "tsx scripts/validate-manifests.ts",
    "check:themes": "tsx scripts/check-themes.ts",
    "check:contracts": "tsx scripts/check-contracts.ts",
    "check:ui-contracts": "tsx scripts/validate-ui-contracts.ts",
    "start:citadelle": "tsx apps/citadelle/src/start.ts",
    "clean": "tsx scripts/clean.ts && rimraf .mosaix/build",
    "clean:all": "tsx scripts/clean.ts --all && rimraf .mosaix/build",
    "clean:dry": "tsx scripts/clean.ts --dry-run --verbose",
    "start": "tsx src/start.ts",
    "serve": "tsx src/start.ts",
    "docker:build": "docker build -t mosaix-platform .",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-boundaries": "^3.0.0",
    "globals": "^17.9.0",
    "prettier": "^3.3.0",
    "rimraf": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@mosaix/adapter-database-sqlite": "workspace:*",
    "@mosaix/adapter-featureflags-memory": "workspace:*",
    "@mosaix/adapter-identity-store-sqlite": "workspace:*",
    "@mosaix/cli": "workspace:*",
    "@mosaix/contracts": "workspace:*",
    "@mosaix/core": "workspace:*",
    "@mosaix/database": "workspace:*",
    "@mosaix/http": "workspace:*",
    "@mosaix/migrations": "workspace:*",
    "@mosaix/migrations": "workspace:*",
    "@mosaix/migrations": "workspace:*",
    "@mosaix/ports-feature-flags": "workspace:*",
    "@mosaix/ports-database": "workspace:*",
    "@mosaix/schemas": "workspace:*",
    "@mosaix/sdk": "workspace:*",
    "@mosaix/security": "workspace:*",
    "@mosaix/support": "workspace:*",
    "zod": "^3.25.76"
  }
}
